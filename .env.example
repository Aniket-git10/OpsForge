# ==============================================================================
# OpsForge Environment Configuration Example
# Copy this file to .env in your root or server directory for local development
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# MongoDB Database Connection
# Local: mongodb://127.0.0.1:27017/opsforge
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/opsforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/opsforge

# JWT Authentication Secrets
JWT_SECRET=opsforge_super_secure_jwt_secret_change_in_production_key_38472918374
JWT_EXPIRES_IN=7d

# AI Engine Configuration
# Supported providers: gemini, openai, heuristic (local fallback)
AI_PROVIDER=gemini
# Optional: Provide Google Gemini API Key (if not provided, OpsForge automatically uses high-precision deterministic heuristic fallback engine)
GEMINI_API_KEY=
# Optional: OpenAI API Key if using openai provider
OPENAI_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
